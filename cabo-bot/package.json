{
  "name": "cabo-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot that sells fishing charters, in-villa massages and paddleboard/kayak rentals in Los Cabos",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/server.js",
    "seed": "node --no-warnings --env-file-if-exists=.env scripts/seed.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
