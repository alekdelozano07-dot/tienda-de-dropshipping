# --- General ---
PORT=3000
# Public URL where this server is reachable (used for payment success pages and QR links)
PUBLIC_URL=https://your-domain.com
BUSINESS_NAME=Cabo Fish & Beach
# Your own WhatsApp number (international format, digits only). Receives escalations and delivery tasks.
OWNER_PHONE=5216240000000
# Public WhatsApp number customers write to (digits only), used to build QR links
BOT_PHONE=5216241111111
# Password for /admin (user: admin)
ADMIN_PASSWORD=change-me
DB_PATH=./data/cabo.db

# --- Business rules ---
DEPOSIT_PERCENT=20
HOLD_MINUTES=30
RENTAL_DELIVERY_FEE=25

# --- WhatsApp Cloud API (Meta) --- leave empty to run in local test mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-secret-string
WHATSAPP_APP_SECRET=
# Approved template with ONE body variable {{1}}, used for captain alerts and reminders
# (WhatsApp blocks free-form messages 24h after the person's last message)
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_NOTIFY_TEMPLATE_LANG=en

# --- Stripe --- leave empty to run in local test mode (fake payment page)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
